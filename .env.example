# Required for LLM (Groq - Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here

# Required for Web Search MCP
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Weather MCP
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional: Flight Search MCP
AVIATION_STACK_API_KEY=your_aviation_stack_api_key_here

# Optional: External PostgreSQL Database URL (Defaults to In-Memory if omitted)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
